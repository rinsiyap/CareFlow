# Copy this file to .env.aws on the EC2 host.
# Replace every CHANGE_ME value before starting CareFlow.

CARE_FLOW_BOOTSTRAP_ADMIN_NAME=CareFlow Administrator
CARE_FLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CARE_FLOW_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
CARE_FLOW_JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
CARE_FLOW_SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/CHANGE_ME_ACCOUNT_ID/CHANGE_ME_QUEUE_NAME
CARE_FLOW_OUTBOX_DISPATCH_BATCH_SIZE=10
